# ---------------------------------------------------------------------------
# Frosted Harmony settings.
# On the SERVER, copy this file to ".env" and fill in the values:
#     cp .env.example .env
#     nano .env
# Never share the real .env file or put it on the internet. It holds passwords.
# ---------------------------------------------------------------------------

# Name used in inquiry emails.
SITE_NAME=Frosted Harmony

# --- Admin portal (docs/ADMIN-SETUP.md) --------------------------------------
# Encrypts passwords and tokens saved from the admin portal. Generate it ON THE SERVER with:
#     openssl rand -hex 32
# Keep a copy somewhere safe (a password manager). If it is lost or changed, secrets saved in
# the portal must be entered again. Leave empty to turn the admin portal off.
ADMIN_ENCRYPTION_KEY=

# Settings below can also be changed in the admin portal; values saved there override this file.

# --- Cloudflare Tunnel (guide Part 8) ---------------------------------------
# The long token Cloudflare shows when you create the tunnel (starts with "eyJ").
CLOUDFLARE_TUNNEL_TOKEN=

# --- Instagram gallery (guide Part 9) -- optional ---------------------------
# Leave empty to use site/gallery.json instead.
# The server refreshes this token automatically so it does not expire.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_POST_LIMIT=12
INSTAGRAM_REFRESH_MINUTES=60

# --- Inquiry form email (guide Part 10) -------------------------------------
# Gmail example: use a Google "App password", NOT the normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Where inquiries are delivered (defaults to SMTP_USER if empty).
MAIL_TO=
# Sender address (defaults to SMTP_USER; Gmail requires it to be your own address).
MAIL_FROM=
